# WordPress .gitignore otimizado
# Ignora todo o core, configurações, uploads, logs e toda a pasta wp-content

# Core do WordPress
/wp-admin/
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php

# Configuração
wp-config.php

# Temas e plugins de exemplo
/wp-content/themes/twenty*/
/wp-content/plugins/hello.php

# Uploads e arquivos de log
/wp-content/uploads/
*.log

# Arquivos de sistema
/.htaccess

# Ignora toda a pasta wp-content (incluindo plugins, temas, uploads, etc.)
/wp-content/

# Ignora arquivos de backup
*backup*